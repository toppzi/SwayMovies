{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/fastfetch/eighties.txt",
        "position": "top",
        "color": {
            "2": "magenta",
            "5": "magenta",
            "6": "cyan"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 1
        }
    },

    "display": {
        "separator": " :: ",
        "color": {
            "keys": "magenta",
            "title": "cyan"
        },
        "bar": {
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "width": 16,
            "border": {
                "left": "[",
                "right": "]"
            }
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "{#@53}┌───────────────────────────────────────────────────┐{#}"
        },
        {
            "type": "custom",
            "format": "{#@53}│ {#@213}[ RETRO ZONE 1985 ]{#@53}  // neon · synth · VHS        │{#}"
        },
        {
            "type": "custom",
            "format": "{#@53}└───────────────────────────────────────────────────┘{#}"
        },
        "break",

        {
            "type": "title",
            "key": "operator",
            "format": "{user-name}@{host-name}"
        },
        "break",

        {
            "type": "custom",
            "format": "{#@53}── {#@51}hardware{#@53} ─────────────────────────────────────{#}"
        },
        {
            "type": "host",
            "key": "machine"
        },
        {
            "type": "cpu",
            "key": "cpu"
        },
        {
            "type": "gpu",
            "key": "gpu",
            "format": "{name}"
        },
        "break",

        {
            "type": "custom",
            "format": "{#@53}── {#@51}software{#@53} ─────────────────────────────────────{#}"
        },
        {
            "type": "os",
            "key": "distro"
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "packages",
            "key": "pkgs",
            "format": "{all}"
        },
        {
            "type": "shell",
            "key": "shell"
        },
        {
            "type": "wm",
            "key": "de/wm"
        },
        {
            "type": "terminal",
            "key": "term"
        },
        "break",

        {
            "type": "custom",
            "format": "{#@53}── {#@51}usage{#@53} ───────────────────────────────────────{#}"
        },
        {
            "type": "memory",
            "key": "mem",
            "format": "{used} / {total}",
            "percent": {
                "type": ["bar", "hide-others"]
            }
        },
        {
            "type": "swap",
            "key": "swap",
            "format": "{used} / {total}"
        },
        {
            "type": "uptime",
            "key": "uptime"
        },
        {
            "type": "command",
            "key": "age",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days=$(( (current - birth_install) / 86400 )); echo \"${days}d uptime on disk\""
        },

        "break",
        {
            "type": "custom",
            "format": "{#@213}▮{#@51} press play on tape...{#}"
        }
    ]
}
