{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/fastfetch/mortalkombat.txt",
        "position": "top",
        "color": {
            "1": "white",
            "2": "blue",
            "3": "magenta",
            "5": "yellow",
            "6": "magenta"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 1
        }
    },

    "display": {
        "separator": " :: ",
        "color": {
            "keys": "magenta",
            "title": "blue"
        },
        "bar": {
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "width": 16,
            "border": {
                "left": "[",
                "right": "]"
            }
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "{#@240}┌───────────────────────────────────────────────────┐{#}"
        },
        {
            "type": "custom",
            "format": "{#@240}│ {#@129}[ FATALITY ]{#@240}  // scorpion · raiden · sub-zero     │{#}"
        },
        {
            "type": "custom",
            "format": "{#@240}└───────────────────────────────────────────────────┘{#}"
        },
        "break",

        {
            "type": "title",
            "key": "operator",
            "format": "{user-name}@{host-name}"
        },
        "break",

        {
            "type": "custom",
            "format": "{#@240}── {#@33}hardware{#@240} ─────────────────────────────────────{#}"
        },
        {
            "type": "host",
            "key": "machine"
        },
        {
            "type": "cpu",
            "key": "cpu"
        },
        {
            "type": "gpu",
            "key": "gpu",
            "format": "{name}"
        },
        "break",

        {
            "type": "custom",
            "format": "{#@240}── {#@33}software{#@240} ─────────────────────────────────────{#}"
        },
        {
            "type": "os",
            "key": "distro"
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "packages",
            "key": "pkgs",
            "format": "{all}"
        },
        {
            "type": "shell",
            "key": "shell"
        },
        {
            "type": "wm",
            "key": "de/wm"
        },
        {
            "type": "terminal",
            "key": "term"
        },
        "break",

        {
            "type": "custom",
            "format": "{#@240}── {#@33}usage{#@240} ───────────────────────────────────────{#}"
        },
        {
            "type": "memory",
            "key": "mem",
            "format": "{used} / {total}",
            "percent": {
                "type": ["bar", "hide-others"]
            }
        },
        {
            "type": "swap",
            "key": "swap",
            "format": "{used} / {total}"
        },
        {
            "type": "uptime",
            "key": "uptime"
        },
        {
            "type": "command",
            "key": "age",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days=$(( (current - birth_install) / 86400 )); echo \"${days}d uptime on disk\""
        },

        "break",
        {
            "type": "custom",
            "format": "{#@129}⚡{#@33} {#@214}⚡{#@129} {#@39}❄{#@240} finish him...{#}"
        }
    ]
}
