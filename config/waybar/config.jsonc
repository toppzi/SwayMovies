// SwayMovies Waybar — Noto Sans Mono throughout (see style.css)
{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "margin-top": 8,
    "margin-left": 16,
    "margin-right": 16,
    "height": 32,
    "spacing": 4,

    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "clock",
        "tray",
        "custom/power"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "Main",
            "2": "Media",
            "3": "Dev",
            "4": "Games",
            "5": "Chat",
            "6": "Misc",
            "7": "7",
            "8": "8",
            "9": "9",
            "10": "10"
        },
        "persistent_workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": []
        }
    },

    "sway/window": {
        "format": "{}",
        "max-length": 72,
        "tooltip": false,
        "separate-outputs": true
    },

    "pulseaudio": {
        "format": "Vol {volume}%",
        "format-muted": "Vol mute",
        "tooltip-format": "{desc}\nVolume: {volume}%",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "WiFi {signalStrength}%",
        "format-ethernet": "LAN",
        "format-disconnected": "Net —",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}",
        "tooltip-format-ethernet": "{ipaddr}/{cidr}\n{ifname}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%",
        "tooltip-format": "CPU: {usage}%",
        "on-click": "kitty btop"
    },

    "memory": {
        "interval": 2,
        "format": "RAM {percentage}%",
        "tooltip-format": "RAM: {percentage}%",
        "on-click": "kitty btop"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b · %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/power": {
        "format": "PWR",
        "tooltip-format": "Power menu",
        "on-click": "~/.config/waybar/power-menu.sh"
    }
}
