/**
 * App launcher — drun only, Terminator / Skynet (kitty / waybar / wallpaper)
 */

configuration {
    modes: "drun";
    show-icons: true;
    icon-theme: "Adwaita";
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec,categories,keywords";
    sort: true;
    sorting-method: "fzf";
    display-drun: "SKYNET";
}

* {
    background-color: transparent;
    font: "Noto Sans Mono 11";

    base: #0c1317;
    surface0: #141414;
    surface1: #242424;
    overlay0: #3d3a41;
    text: #e8eae5;
    subtext: #808983;
    red: #e60000;
    chrome: #c7c4b5;

    background: @base;
    foreground: @text;
    normal-background: @surface0;
    normal-foreground: @text;
    alternate-normal-background: @surface0;
    alternate-normal-foreground: @text;
    selected-normal-background: @surface1;
    selected-normal-foreground: @text;
    active-foreground: @red;
    urgent-foreground: #ff1a1a;
}

window {
    location: center;
    anchor: center;
    width: 44em;
    border: 2px;
    border-radius: 4px;
    border-color: @red;
    background-color: rgba(12, 19, 23, 94%);
    padding: 14px;
}

mainbox {
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @red;
    padding: 0 6px 0 0;
}

entry {
    background-color: @surface0;
    text-color: @text;
    placeholder: "Search applications…";
    placeholder-color: @overlay0;
    padding: 10px 12px;
    border-radius: 2px;
    border: 1px;
    border-color: @surface1;
}

listview {
    columns: 2;
    lines: 8;
    fixed-columns: true;
    cycle: false;
    spacing: 8px;
    scrollbar: true;
}

element {
    orientation: horizontal;
    spacing: 10px;
    padding: 10px 12px;
    border-radius: 2px;
    border: 1px;
    border-color: transparent;
    cursor: pointer;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 32px;
    cursor: inherit;
}

element-text {
    text-color: @text;
    vertical-align: 0.5;
    cursor: inherit;
}

element normal normal {
    background-color: @surface0;
}

element alternate normal {
    background-color: rgba(20, 20, 20, 80%);
}

element selected normal {
    background-color: @surface1;
    border-color: @red;
    text-color: @text;
}

element selected {
    background-color: @surface1;
}

scrollbar {
    width: 6px;
    handle-color: @overlay0;
    handle-width: 6px;
    border-radius: 0;
    padding: 0;
}
